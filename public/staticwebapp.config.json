{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/favicon.ico",
      "redirect": "/favicon.svg"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/*.{css,ico,js,json,png,svg,txt,webp}"
    ]
  }
}
